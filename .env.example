# TiffinTrack Environment Variables
# Provide your Supabase project credentials below

# Server-side Supabase credentials (Privileged keys must remain server-side only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Client-side Supabase public parameters
VITE_SUPABASE_URL=
